# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts



# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/

# production
/build

# secrets: NEVER commit API keys
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# testing / coverage
/coverage

# typescript
*.tsbuildinfo
next-env.d.ts

# OS and editor files
.DS_Store
Thumbs.db
.idea/
*.swp
# keep shared VS Code settings, ignore personal ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# misc
*.pem
tmp/

# NOTE: data/scam-embeddings.json and data/eval-results.json are
# intentionally COMMITTED (the deployed app reads them at runtime).
